<configuration>
<!--for writing to stubInfo.log:-->
<appender name="INFO_FILE"
          class="ch.qos.logback.core.FileAppender">
    <file>logs/stubInfo.log</file>

    <filter class="ch.qos.logback.classic.filter.LevelFilter">
        <level>INFO</level>
        <onMatch>ACCEPT</onMatch>
        <onMismatch>DENY</onMismatch>
    </filter>

    <encoder class="net.logstash.logback.encoder.LogstashEncoder">

        <fieldNames>
            <thread>[ignore]</thread>
            <version>[ignore]</version>
            <message>[ignore]</message>
            <levelValue>[ignore]</levelValue>
            <logger>[ignore]</logger>
            <level>[ignore]</level>
        </fieldNames>
    </encoder>
</appender>
<!--for writing to stubDebug.log:-->
<appender name="DEBUG_FILE"
          class="ch.qos.logback.core.FileAppender">
    <file>logs/stubDebug.log</file>

    <filter class="ch.qos.logback.classic.filter.LevelFilter">
        <level>DEBUG</level>
        <onMatch>ACCEPT</onMatch>
        <onMismatch>DENY</onMismatch>
    </filter>

    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <fieldNames>
            <thread>[ignore]</thread>
            <version>[ignore]</version>
            <message>[ignore]</message>
            <levelValue>[ignore]</levelValue>
            <logger>[ignore]</logger>
            <level>[ignore]</level>
        </fieldNames>
    </encoder>
</appender>

<root level="DEBUG"> 
<!--root logger currently accpets all log events DEBUG or higher (so including INFO)-->
<!--if you want INFO logging only exchange root level="DEBUG" in line above with root level="INFO"-->
    <appender-ref ref="INFO_FILE"/>
    <appender-ref ref="DEBUG_FILE"/>
</root>

</configuration>
