FROM sapmachine:26-jdk-ubuntu-noble

# Install Maven inside the container
RUN apt-get update && apt-get install -y maven && rm -rf /var/lib/apt/lists/*

WORKDIR /test-env

# Copy dependency mappings first to optimize caching
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copy source code
COPY src ./src

# Default action to execute if no overrides are provided
CMD ["mvn", "test", "-Dtest=StubResolverTest"]